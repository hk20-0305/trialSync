# ==========================================
# TrialSync - Backend Environment Example
# Copy to .env and fill in values locally. Never commit credentials.
# ==========================================

# ---------- PostgreSQL ----------
DATABASE_URL=jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=

# ---------- Spring Server ----------
PORT=8000

# ---------- TrialSync Application ----------
TRIALSYNC_ENVIRONMENT=development
TRIALSYNC_DEBUG=false

# Must be at least 32 characters.
TRIALSYNC_AUTH_SECRET=replace-with-a-32-character-minimum-secret
TRIALSYNC_ACCESS_TOKEN_MINUTES=480
TRIALSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Screening Batch Limits ----------
TRIALSYNC_SCREENING_BATCH_MAX_PATIENTS=50
TRIALSYNC_SCREENING_BATCH_MAX_TRIALS=10
TRIALSYNC_SCREENING_BATCH_MAX_PAIRS=500

# ---------- Groq / Extraction / Screening Chat ----------
GROQ_API_KEY=
TRIALSYNC_GROQ_MODEL=openai/gpt-oss-20b
TRIALSYNC_EXTRACTION_PROVIDER=groq
TRIALSYNC_SCREENING_CHAT_PROVIDER=auto
TRIALSYNC_PROVIDER_TIMEOUT_SECONDS=12.0
TRIALSYNC_PROVIDER_MAX_RETRIES=1
TRIALSYNC_PROVIDER_MAX_INPUT_CHARS=100000

# ---------- Screening Chat Conversation ----------
TRIALSYNC_SCREENING_CHAT_MESSAGE_MAX_CHARS=1000
TRIALSYNC_SCREENING_CHAT_MAX_MESSAGES=10
TRIALSYNC_SCREENING_CHAT_MAX_ANSWER_CHARS=2000

# ---------- Clinical Terminology ----------
TRIALSYNC_TERMINOLOGY_SUGGESTIONS_ENABLED=true
TRIALSYNC_TERMINOLOGY_TIMEOUT_SECONDS=5.0
TRIALSYNC_TERMINOLOGY_MAX_RESULTS=5

# Optional: LOINC lookup uses a free account username/password with Basic Auth
TRIALSYNC_LOINC_USERNAME=
TRIALSYNC_LOINC_PASSWORD=

# ---------- RAG / Embeddings / Gemini ----------
GEMINI_API_KEY=
TRIALSYNC_ELIGIBILITY_RAG_PROVIDER=gemini
TRIALSYNC_GEMINI_MODEL=gemini-1.5-flash
TRIALSYNC_RAG_TIMEOUT_SECONDS=15.0
TRIALSYNC_RAG_TOP_K=5
