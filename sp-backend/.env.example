# Copy to .env and fill in locally. Never commit real credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/trialsync
DATABASE_USERNAME=trialsync
DATABASE_PASSWORD=change-me

# Must be at least 32 characters.
TRIALSYNC_AUTH_SECRET=replace-with-a-32-character-minimum-secret
TRIALSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional external providers. Leaving these blank keeps the deterministic fallbacks active.
GROQ_API_KEY=
TRIALSYNC_LOINC_USERNAME=
TRIALSYNC_LOINC_PASSWORD=
